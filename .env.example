# ============================================================
#  本机配置模板
#  复制为 .env 后按需修改。.env 已被 .gitignore 屏蔽,不会进版本库。
# ============================================================

# 数据库连接串。
# 留空或删除此行 = 用工作区内 data/fin.db 的 SQLite(零配置)。
#
# 切到 MySQL(注意:先把密码里的特殊字符做 URL 编码,如 @ -> %40):
# FIN_DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/fin_sentiment?charset=utf8mb4

# 采集超时(秒)
# FIN_REQUEST_TIMEOUT=20
