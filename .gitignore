# ============================================================
#  毕设项目 .gitignore
#  原则:源码和文档进版本库;依赖、缓存、数据、模型权重一律不进
# ============================================================

# ---------- 依赖 ----------
node_modules/
.pnpm-store/

# ---------- 工具缓存 / 虚拟环境(放在工作区内,避免沙箱拦截) ----------
.npm-cache/
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------- 构建产物 ----------
dist/
dist-ssr/
build/
*.local
*.tsbuildinfo

# ---------- 数据(体积大,不进版本库;需要时按文件名单独放行) ----------
# 用 data/* 而不是 data/:写 data/ 会把目录本身排除掉,git 就不会再进这个
# 目录,下面的 !data/experiments/ 也就无从生效(规则:父目录被排除时,
# 子文件无法被重新包含)。
data/*
!data/experiments/
!data/experiments/*.json
!data/experiments/*.md
*.csv
*.parquet
*.jsonl
*.xlsx

# ---------- 模型权重与训练产物 ----------
# models/ 整目录不进版本库:权重 392 MB,且随时可用
#   .python\python.exe tools\fetch_model.py
# 重新拉下来。半进半不进(小文件进、权重大小不进)会让干净检出
# 拿到一个"有配置没权重"的残缺模型,反而更难排查。
models/
*.pth
*.pt
*.onnx
*.ckpt
*.safetensors
*.bin
runs/
wandb/
outputs/
checkpoints/

# ---------- 日志与分词缓存 ----------
logs/
*.log
npm-debug.log*
yarn-error.log*
# jieba 首次分词会生成 ~9 MB 缓存,纯机器产物,换台机器自动重建
jieba.cache
.tmp*.cache

# ---------- 环境变量与密钥 ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- 编辑器 / 系统 ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ---------- 本机沙箱环境(全部收敛在工作区内,不进版本库) ----------
.tmp/
.pip-cache/
.pylibs/
.pylibs-*/
.python/
.git-trust/

# ---------- 内置 skill 的测试夹具(.dsh/skills 是上游原样 vendor 的第三方内容) ----------
# 上面的 *.jsonl 等规则是给"数据集/日志"写的,会误伤 skill 自带的测试夹具,
# 导致上游脚本在干净检出里跑不起来。这里按目录精确放行,不影响别处。
!.dsh/skills/**/fixtures/**
!.dsh/skills/**/fixtures/**/*.jsonl
!.dsh/skills/**/fixtures/**/*.csv
!.dsh/skills/**/fixtures/**/*.log
!.dsh/skills/**/fixtures/**/*.json

# ---------- 设计技能的工作产物 ----------
# design-taste-frontend 的 draw.mjs 会把抽到的设计方向写到 cwd 下的
# .taste-skill/direction.json(上游自己的 .gitignore 里也忽略它)。
.taste-skill/

# ---------- 论文材料的导出产物 ----------
# 论文一律先用 Markdown 写(可 diff、可 grep、可版本管理),再用
#   .python\python.exe tools\md_to_docx.py 论文\开题报告书.md
# 导出 Word。docx 是二进制、diff 不可读,而且与 .md 同时进库必然漂移
# (改了 .md 忘了重新导出,库里就留着一份过期 Word)。只保留 .md 作唯一
# 事实来源,docx 随时一条命令重建。
论文/*.docx
~$*.docx

